* text=auto eol=lf
*.m   text eol=lf
*.h   text eol=lf
*.c   text eol=lf
Makefile   text eol=lf
control    text eol=lf
*.plist    text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.png     binary
*.x       text eol=lf
*.deb     binary
# apt metadata must stay byte-exact: LF endings, no filtering. These come after
# `*.deb binary` on purpose: a later rule wins, and `dist/**` would otherwise
# re-mark nested packages as text and rewrite their bytes.
dist/**            text eol=lf
dist/**/*.gz       binary
dist/**/pool/**    binary
